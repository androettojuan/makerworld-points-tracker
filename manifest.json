{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Points Tracker",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*"
      ],
      "js": [
        "src/sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*"
      ],
      "js": [
        "src/cards.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "128": "icons/icon128.png"
  }
}
